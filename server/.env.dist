# -------------------------
# Server
# -------------------------
PORT=8000
IS_PRODUCTION=false
# Client origin (no trailing slash): used for email links and as the allowed CORS origin.
CLIENT_URL=http://localhost:5173
# Leave empty locally and on *.vercel.app (cookies become SameSite=None in production).
# Set only when client and API share a custom apex domain (e.g. .example.com) → SameSite=Lax.
COOKIE_DOMAIN=

# -------------------------
# Database
# -------------------------
MONGO_URL=mongodb://localhost:27017/anapal-intercambio

# -------------------------
# Auth
# -------------------------
ACCESS_TOKEN_SECRET=change-me
# HMAC key for hashing refresh tokens
REFRESH_TOKEN_SECRET=change-me
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30
EMAIL_CONFIRMATION_SECRET=change-me
EMAIL_CONFIRMATION_TTL=24h

# -------------------------
# Email (Resend free tier: 100/day, 3000/month)
# -------------------------
RESEND_API_KEY=
EMAIL_FROM="Intercambios ANAPAL <noreply@example.com>"

# -------------------------
# Seed
# -------------------------
SUPERADMIN_EMAIL=
SUPERADMIN_PASSWORD=
SUPERADMIN_RECEPTOR_NUMBER=00000
