{
    "name": "@anapal/server",
    "version": "0.1.0",
    "private": true,
    "license": "UNLICENSED",
    "type": "module",
    "main": "dist/index.js",
    "scripts": {
        "dev": "tsx watch --env-file-if-exists=.env src/index.ts",
        "build": "tsup",
        "start": "node --env-file-if-exists=.env dist/index.js",
        "seed": "tsx --env-file-if-exists=.env src/seed/index.ts",
        "lint": "eslint .",
        "typecheck": "tsc --noEmit"
    },
    "dependencies": {
        "@anapal/shared": "workspace:*",
        "bcrypt": "^6.0.0",
        "cookie-parser": "^1.4.7",
        "cors": "^2.8.5",
        "express": "^5.1.0",
        "express-rate-limit": "^8.0.1",
        "helmet": "^8.1.0",
        "jsonwebtoken": "^9.0.2",
        "mongoose": "^8.18.0",
        "request-ip": "^3.3.0",
        "resend": "^6.0.1",
        "zod": "^3.25.76"
    },
    "devDependencies": {
        "@eslint/js": "^9.32.0",
        "@types/bcrypt": "^6.0.0",
        "@types/cookie-parser": "^1.4.9",
        "@types/cors": "^2.8.19",
        "@types/express": "^5.0.3",
        "@types/jsonwebtoken": "^9.0.10",
        "@types/node": "^24.3.0",
        "@types/request-ip": "^0.0.41",
        "eslint": "^9.32.0",
        "globals": "^16.3.0",
        "tsup": "^8.5.0",
        "tsx": "^4.20.5",
        "typescript": "^5.9.2",
        "typescript-eslint": "^8.39.0"
    }
}
